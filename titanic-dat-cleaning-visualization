      "source": [
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "# Function to detect and handle outliers using IQR\n",
        "def handle_outliers_iqr(df, column):\n",
        "    Q1 = df[column].quantile(0.25)\n",
        "    Q3 = df[column].quantile(0.75)\n",
        "    IQR = Q3 - Q1\n",
        "    lower_bound = Q1 - 1.5 * IQR\n",
        "    upper_bound = Q3 + 1.5 * IQR\n",
        "\n",
        "    # Display current boxplot before handling outliers\n",
        "    plt.figure(figsize=(12, 5))\n",
        "    plt.subplot(1, 2, 1)\n",
        "    sns.boxplot(y=df[column])\n",
        "    plt.title(f'Boxplot of {column} (Before Outlier Handling)')\n",
        "    plt.ylabel(column)\n",
        "\n",
        "    # Identify outliers\n",
        "    outliers = df[(df[column] < lower_bound) | (df[column] > upper_bound)]\n",
        "    print(f\"Number of outliers in '{column}': {len(outliers)}\")\n",
        "\n",
        "    # Replace outliers with the bounds (capping)\n",
        "    df[column] = df[column].clip(lower=lower_bound, upper=upper_bound)\n",
        "\n",
        "    # Display boxplot after handling outliers\n",
        "    plt.subplot(1, 2, 2)\n",
        "    sns.boxplot(y=df[column])\n",
        "    plt.title(f'Boxplot of {column} (After Outlier Handling)')\n",
        "    plt.ylabel(column)\n",
        "    plt.tight_layout()\n",
        "    plt.show()\n",
        "\n",
        "    return df\n",
        "\n",
        "# Handle outliers for 'Age'\n",
        "df = handle_outliers_iqr(df.copy(), 'Age') # Use .copy() to avoid SettingWithCopyWarning\n",
        "\n",
        "# Handle outliers for 'Fare'\n",
        "df = handle_outliers_iqr(df.copy(), 'Fare') # Use .copy() to avoid SettingWithCopyWarning\n",
        "\n",
        "print(\"Outliers in 'Age' and 'Fare' columns have been detected and capped.\")"
      ],
